{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "data"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventVersion",
        "occurredAt"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "customerId",
        "items"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "customerId": {
          "type": "string",
          "format": "uuid"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sku",
              "quantity"
            ],
            "properties": {
              "sku": {
                "type": "string"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}